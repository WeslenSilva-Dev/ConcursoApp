<div class="card">
  <div class="card-header">
    <h2 class="card-title">Progresso das metas</h2>
    <a href="/goals" class="card-action">Editar</a>
  </div>

  <div class="goal-item">
    <div class="goal-label">
      <span>Diaria</span>
      <span><%= (todayMinutes / 60).toFixed(1) %>h / <%= dailyGoalHours %>h</span>
    </div>
    <div class="progress-bar"><div class="progress-fill progress-fill--daily" style="width:<%= dailyProgress %>%"></div></div>
    <div class="goal-pct"><%= dailyProgress %>%</div>
  </div>

  <div class="goal-item mt-3">
    <div class="goal-label">
      <span>Semanal</span>
      <span><%= (weekMinutes / 60).toFixed(1) %>h / <%= weeklyGoalHours %>h</span>
    </div>
    <div class="progress-bar"><div class="progress-fill progress-fill--weekly" style="width:<%= weeklyProgress %>%"></div></div>
    <div class="goal-pct"><%= weeklyProgress %>%</div>
  </div>
</div>
