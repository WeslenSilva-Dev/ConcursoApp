<div class="card">
  <div class="card-header">
    <h2 class="card-title">Revisões do dia</h2>
    <a href="/reviews" class="card-action">Ver todas</a>
  </div>

  <% if (todayReviews.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <p>Nenhuma revisão pendente hoje</p>
    </div>
  <% } else { %>
    <ul class="review-list">
      <% todayReviews.slice(0, 6).forEach((review) => { %>
        <li class="review-item <%= review.completed ? 'review-item--done' : '' %>" id="ri-<%= review._id %>">
          <button class="review-check" data-review-toggle data-review-id="<%= review._id %>">
            <% if (review.completed) { %>✓<% } %>
          </button>
          <div class="review-item__content">
            <div class="review-subject"><%= review.subject %></div>
            <div class="review-meta">Revisão de <%= review.interval %> dia<%= review.interval !== 1 ? 's' : '' %></div>
          </div>
          <button class="btn btn--outline btn--xs" data-review-toggle data-review-id="<%= review._id %>">Revisar</button>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>