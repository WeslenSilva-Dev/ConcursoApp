<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="ConcursoApp - Plataforma de estudos para concursos publicos.">
  <title><%= typeof title !== 'undefined' ? `${title} - ConcursoApp` : 'ConcursoApp' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/logo.svg">
  <link rel="stylesheet" href="/css/style.css">
  <% const safePageStyles = typeof pageStyles !== 'undefined' ? pageStyles : []; %>
  <% safePageStyles.forEach(function(pageStyle) { %>
    <link rel="stylesheet" href="<%= pageStyle %>">
  <% }) %>
</head>
<body class="auth-body">
  <div class="auth-container">
    <%- body %>
  </div>
  <% const safePageScripts = typeof pageScripts !== 'undefined' ? pageScripts : []; %>
  <% safePageScripts.forEach(function(pageScript) { %>
    <script src="<%= pageScript %>"></script>
  <% }) %>
  <script>
    (function() {
      const theme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</body>
</html>