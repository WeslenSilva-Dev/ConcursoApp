<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="ConcursoApp - Plataforma inteligente de estudos para concursos publicos.">
  <title><%= typeof title !== 'undefined' ? `${title} - ConcursoApp` : 'ConcursoApp' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="icon" type="image/svg+xml" href="/logo.svg">
  <link rel="stylesheet" href="/css/style.css">
  <% const safePageStyles = typeof pageStyles !== 'undefined' ? pageStyles : []; %>
  <% safePageStyles.forEach(function(pageStyle) { %>
    <link rel="stylesheet" href="<%= pageStyle %>">
  <% }) %>
  <script>
    (function() {
      const theme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body>
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header" style="display:flex; align-items:center; gap:0.5rem; padding: 1.5rem;">
      <a href="/dashboard" style="display:flex; align-items:center; justify-content:center; flex-shrink:0; transition: transform 0.2s ease;">
        <img src="/logo.svg" alt="ConcursoApp Logo" width="36" height="36" style="border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
      </a>
      <div>
        <a href="/dashboard" class="logo">ConcursoApp</a>
        <div style="font-size:0.7rem; color:var(--text-muted); font-weight:500;">Concursos Publicos</div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-item <%= currentPage === 'dashboard' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
        </span>
        Dashboard
      </a>
      <a href="/cycles" class="nav-item <%= currentPage === 'cycles' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </span>
        Ciclos
      </a>
      <a href="/stats" class="nav-item <%= currentPage === 'stats' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
        </span>
        Estatísticas
      </a>
      <a href="/sessions/focus" class="nav-item <%= currentPage === 'focus' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
        Modo Foco
      </a>
      <a href="/reviews" class="nav-item <%= currentPage === 'reviews' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        </span>
        Revisões
      </a>
      <a href="/notes" class="nav-item <%= currentPage === 'notes' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </span>
        Anotações
      </a>
      <a href="/goals" class="nav-item <%= currentPage === 'goals' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
        </span>
        Metas
      </a>
    </nav>

    <div class="sidebar-footer">
      <button class="theme-toggle-btn" onclick="toggleTheme()" id="themeToggleBtn" title="Alternar tema">
        <span class="nav-icon" id="themeIcon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </span>
        <span id="themeLabel">Tema claro</span>
      </button>

      <div class="user-card">
        <div class="user-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
        <div class="user-info">
          <div class="user-name"><%= user.name %></div>
          <a href="/auth/logout" class="logout-link">Sair</a>
        </div>
      </div>
    </div>
  </aside>

  <main class="main-content">
    <% if (locals.flash && flash) { %>
      <div class="flash flash--<%= flash.type %>">
        <%= flash.message %>
        <button class="flash-close" onclick="this.parentElement.remove()">x</button>
      </div>
    <% } %>
    <%- body %>
  </main>

  <nav class="mobile-nav">
    <a href="/dashboard" class="mobile-nav-item <%= currentPage === 'dashboard' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
      <span>Dashboard</span>
    </a>
    <a href="/cycles" class="mobile-nav-item <%= currentPage === 'cycles' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      <span>Ciclos</span>
    </a>
    <a href="/stats" class="mobile-nav-item <%= currentPage === 'stats' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
      <span>Stats</span>
    </a>
    <a href="/sessions/focus" class="mobile-nav-item <%= currentPage === 'focus' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>Foco</span>
    </a>
    <a href="/reviews" class="mobile-nav-item <%= currentPage === 'reviews' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
      <span>Revisões</span>
    </a>
    <a href="/notes" class="mobile-nav-item <%= currentPage === 'notes' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <span>Notas</span>
    </a>
  </nav>

  <script src="/js/timer.js"></script>
  <script src="/js/agenda.js"></script>
  <% const safePageScripts = typeof pageScripts !== 'undefined' ? pageScripts : []; %>
  <% safePageScripts.forEach(function(pageScript) { %>
    <script src="<%= pageScript %>"></script>
  <% }) %>

  <script>
    function toggleTheme() {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme') || 'light';
      const next = current === 'light' ? 'dark' : 'light';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateThemeUI(next);
    }

    function updateThemeUI(theme) {
      const label = document.getElementById('themeLabel');
      const icon = document.getElementById('themeIcon');
      if (!label || !icon) return;

      if (theme === 'dark') {
        label.textContent = 'Tema escuro';
        icon.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
      } else {
        label.textContent = 'Tema claro';
        icon.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
      }
    }

    updateThemeUI(document.documentElement.getAttribute('data-theme') || 'light');
  </script>
</body>
</html>
