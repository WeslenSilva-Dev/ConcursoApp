<div class="page-header">
  <div>
    <h1 class="page-title">Revisões</h1>
    <p class="page-subtitle">Gerencie suas revisoes programadas</p>
  </div>
</div>

<div class="stats-grid" style="grid-template-columns: 1fr 1fr; max-width: 900px; margin: 0 auto; margin-bottom: 2rem;">
  <div class="card" style="display:flex; align-items:center; gap:1rem; padding:1.25rem;">
    <div style="width: 48px; height: 48px; border-radius: 50%; background: var(--orange-dim); color: var(--orange); display:flex; align-items:center; justify-content:center;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <div>
      <div style="font-size:0.875rem; color:var(--text-secondary); font-weight:600;">Concluidas hoje</div>
      <div style="font-size:1.5rem; font-weight:800;"><%= todayReviews.filter((review) => review.completed).length %> de <%= todayReviews.length %></div>
    </div>
  </div>

  <div class="card" style="display:flex; align-items:center; gap:1rem; padding:1.25rem;">
    <div style="width: 48px; height: 48px; border-radius: 8px; border: 1.5px solid var(--border); color: var(--text-secondary); display:flex; align-items:center; justify-content:center;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </div>
    <div>
      <div style="font-size:0.875rem; color:var(--text-secondary); font-weight:600;">Próximas revisões</div>
      <div style="font-size:1.5rem; font-weight:800;"><%= upcomingReviews.length %></div>
    </div>
  </div>
</div>

<div style="max-width: 900px; margin: 0 auto;">
  <div class="card" style="margin-bottom: 2rem; padding: 2rem;">
    <h2 style="font-size:1.1rem; font-weight:700; margin-bottom:1.5rem;">Revisões de hoje</h2>

    <% if (todayReviews.length === 0) { %>
      <div class="empty-state empty-state--sm">
        <p>Voce nao tem revisoes para hoje.</p>
      </div>
    <% } else { %>
      <div style="display:flex; flex-direction:column; gap:0.75rem;">
        <% todayReviews.forEach((review) => { %>
          <div id="ri-<%= review._id %>" style="display:flex; align-items:center; justify-content:space-between; padding:1rem 1.25rem; border-radius:var(--radius-sm); border:1.5px solid <%= review.completed ? 'var(--orange)' : 'var(--border)' %>; background: <%= review.completed ? 'rgba(245, 158, 11, 0.05)' : 'var(--bg)' %>; transition: all var(--transition);">
            <div style="display:flex; align-items:center; gap:1rem;">
              <div style="width:24px; height:24px; border-radius:50%; border:2px solid <%= review.completed ? 'var(--orange)' : 'var(--text-muted)' %>; color: <%= review.completed ? 'var(--orange)' : 'transparent' %>; display:flex; align-items:center; justify-content:center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <span style="font-size:0.95rem; font-weight:500; color: <%= review.completed ? 'var(--text-secondary)' : 'var(--text)' %>;"><%= review.subject %></span>
            </div>

            <button onclick="toggleReview('<%= review._id %>')" style="padding:0.5rem 1.25rem; border-radius:var(--radius-full); font-size:0.8rem; font-weight:600; cursor:pointer; <%= review.completed ? 'background:transparent; color:var(--text-secondary); border:none;' : 'background:var(--accent); color:#fff; border:none;' %>">
              <%= review.completed ? 'Desfazer' : 'Concluir' %>
            </button>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div style="margin-bottom: 2rem;">
    <h2 style="font-size:1.1rem; font-weight:700; margin-bottom:1.5rem;">Proximas revisoes</h2>

    <% if (upcomingReviews.length === 0) { %>
      <div class="card" style="padding: 1.5rem; text-align:center;">
        <span style="color:var(--text-muted); font-size:0.9rem;">Nenhuma revisao programada para os proximos dias.</span>
      </div>
    <% } else { %>
      <div style="display:flex; flex-direction:column; gap:0.75rem;">
        <% upcomingReviews.forEach((review) => { %>
          <div style="padding:1rem 1.25rem; border-radius:var(--radius-sm); border:1.5px solid var(--border); background:var(--bg-secondary);">
            <div style="font-size:0.95rem; font-weight:500; color:var(--text); margin-bottom:4px;"><%= review.subject %></div>
            <div style="font-size:0.75rem; color:var(--text-secondary);">
              <%= new Date(review.reviewDate).toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long' }) %>
              (Daqui a <%= Math.ceil((new Date(review.reviewDate).getTime() - new Date().getTime()) / (1000 * 3600 * 24)) %> dias)
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
  async function toggleReview(id) {
    try {
      const response = await fetch(`/reviews/${id}/complete`, { method: 'PATCH' });
      if (response.ok) {
        window.location.reload();
      }
    } catch (error) {
      console.error(error);
    }
  }
</script>