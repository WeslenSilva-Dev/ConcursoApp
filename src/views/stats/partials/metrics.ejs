<div class="stats-grid">
  <div class="stat-card stat-card--centered">
    <div class="stat-icon stat-icon--blue">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div>
      <div class="stat-label">Total da semana</div>
      <div class="stat-value"><%= Math.floor(weekTotal) %>h <span class="stat-unit"><%= Math.round((weekTotal - Math.floor(weekTotal)) * 60) %>min</span></div>
    </div>
  </div>

  <div class="stat-card stat-card--centered">
    <div class="stat-icon stat-icon--teal">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
    </div>
    <div>
      <div class="stat-label">Media diaria</div>
      <div class="stat-value"><%= Math.floor(weekAvg) %>h <span class="stat-unit"><%= Math.round((weekAvg - Math.floor(weekAvg)) * 60) %>min</span></div>
    </div>
  </div>

  <div class="stat-card stat-card--centered">
    <div class="stat-icon stat-icon--orange">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    </div>
    <div>
      <div class="stat-label">Sequencia atual</div>
      <div class="stat-value"><%= streak %> <span class="stat-unit">dias</span></div>
    </div>
  </div>
</div>
