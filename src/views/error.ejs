<div class="auth-card auth-card--error">
  <div class="auth-brand">
    <div class="auth-brand-icon">⚡</div>
    <h1 class="auth-brand-name">ConcursoApp</h1>
  </div>
  <div class="error-code">404</div>
  <h2 class="error-title"><%= title || 'Erro' %></h2>
  <p class="error-message"><%= message || 'Algo deu errado.' %></p>
  <a href="/dashboard" class="btn btn--primary">Voltar ao Dashboard</a>
</div>
